secret = 77
tries = 0
while True:
    guess = int(input("Guess the number (1-100): "))        #in first version program takes number as a string i added int.
    tries += 1           #in first version tries is 1 all the time i added '+' so it in increases every loop.
    if guess < secret:
        print("Too low!")       #syntax error on this line i added quatation mark after the exclamation mark.
    elif guess > secret:
        print("Too high!")
    else:
        print(f"Correct! You found it in {tries} tries.")
        break
